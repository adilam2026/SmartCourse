# SERVICE RAILWAY DE RECETTE UNIQUEMENT (projet Railway séparé de la production). La production garde « Dockerfile ».
# Même application, mêmes étapes de construction que « Dockerfile » (Node fixé à la même empreinte), plus trois éléments de
# recette : un faux service d'envoi d'e-mails local (aucun e-mail réel ne peut partir), la création d'une famille FICTIVE au
# premier démarrage, et un garde-fou qui refuse de démarrer hors d'un projet Railway dont le nom contient « recette ».
# Sans les clients pg_dump : la recette n'a pas de sauvegardes.
ARG NODE_IMAGE=node:22.23.4-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da

FROM ${NODE_IMAGE} AS web
WORKDIR /app/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
ARG RAILWAY_GIT_COMMIT_SHA
ENV RAILWAY_GIT_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA
RUN npm run build

FROM ${NODE_IMAGE} AS build
WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci
COPY server/ ./
RUN npm run build

FROM ${NODE_IMAGE}
WORKDIR /app/server
ENV NODE_ENV=production
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/server/dist ./dist
COPY server/migrations ./migrations
COPY server/catalog-photos ./catalog-photos
COPY server/assetlinks.json ./assetlinks.json
COPY --from=web /app/web/dist /app/web/dist
COPY scripts/mock-brevo.mjs scripts/recette-seed.mjs scripts/recette-railway.sh /app/recette/
RUN mkdir -p /app/server/data && chown -R node:node /app/server/data
USER node
EXPOSE 3000
CMD ["sh", "/app/recette/recette-railway.sh"]
